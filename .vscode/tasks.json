{
    // Tasks for the master (LDaCA Text Analytics Tools) repo.
    //
    // The ``Start Wordflow`` task launches the backend + frontend together
    // in parallel — one click via "Tasks: Run Task" → "Start Wordflow" (or
    // bind it to a keyboard shortcut). The individual ``Start Backend`` /
    // ``Start Frontend`` tasks are also kept exposed so they can be
    // stopped / restarted independently from the Terminal tab.
    //
    // Run from whatever branch the ldaca_wordflow submodule is currently
    // checked out on, so a ``git checkout`` in the submodule changes what
    // these tasks actually launch.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "shell",
            // ``.venv/bin/python -m uvicorn`` (not ``uv run uvicorn``
            // and not ``.venv/bin/uvicorn``):
            //  - ``uv run uvicorn`` falls through to whatever uvicorn
            //    is on $PATH (pipx in this user's case) when VS Code
            //    auto-activates the master shim ``.venv`` first,
            //    breaking with ``ModuleNotFoundError: docworkspace``.
            //  - ``.venv/bin/uvicorn`` has a stale shebang from before
            //    the v0.4.2 rename (``#!.../ldaca_web_app/backend/...``)
            //    and the script wasn't regenerated, so direct
            //    invocation dies with ``No such file or directory``.
            // ``python -m uvicorn`` sidesteps both issues — it uses
            // the venv's python (resolved via .venv/bin/python symlink)
            // and finds uvicorn from that venv's site-packages.
            "command": ".venv/bin/python -m uvicorn ldaca_wordflow.main:app --reload --port 8001",
            "options": {
                "cwd": "${workspaceFolder}/ldaca_wordflow/backend",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/ldaca_wordflow/backend/src",
                    // Override the master-venv activation so any
                    // subprocess (uv tooling, pip, etc.) that reads
                    // VIRTUAL_ENV sees the backend's venv.
                    "VIRTUAL_ENV": "${workspaceFolder}/ldaca_wordflow/backend/.venv"
                }
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "group": "wordflow",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/ldaca_wordflow/frontend"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "group": "wordflow",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Start Wordflow",
            "dependsOn": [
                "Start Backend",
                "Start Frontend"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
